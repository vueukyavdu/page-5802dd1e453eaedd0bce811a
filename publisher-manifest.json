isplay:grid;grid-template-columns:repeat(3,1fr);gap:0;border-top:1px solid var(--line);border-bottom:1px solid var(--line);margin-top:30px}\n.strip div{padding:16px 16px 14px;border-right:1px solid var(--line)}\n.strip div:last-child{border-right:0}\n.strip .k{font-size:11px;letter-spacing:.16em;color:var(--mid);display:block}\n.strip .v{font-size:15px;font-weight:600;margin-top:3px;display:block}\n\n/* 步骤 */\n.steps{display:grid;grid-template-columns:repeat(2,1fr);gap:20px}\n.step-ticket{background:var(--card);border:1px dashed var(--ink-2);padding:20px 18px 18px 18px}\n.step-ticket .num{font-size:26px;font-weight:800;line-height:1;color:var(--accent);letter-spacing:.04em}\n.step-ticket h3{margin:10px 0 6px;font-size:16px;letter-spacing:.04em}\n.step-ticket p{margin:0;font-size:14px;color:var(--ink-2)}\n.hint{margin:22px 0 0;font-size:13.5px;color:var(--mid)}\n.hint strong{color:var(--ink);font-weight:600}\n\n/* FAQ 对话气泡 */\n.chat{display:flex;flex-direction:column;gap:18px}\n.chat-row{display:flex;gap:12px;align-items:flex-start}\n.chat-row .avatar{flex:none;width:30px;height:30px;border-radius:50%;border:1px solid var(--ink);display:flex;align-items:center;justify-content:center;font-size:12px;font-weight:700;background:var(--card)}\n.chat-row.q .avatar{background:var(--ink);color:#fff;border-color:var(--ink)}\n.bubble{background:var(--card);border:1px dashed var(--line);padding:14px 16px;max-width:720px}\n.chat-row.q .bubble{border-style:solid;border-color:var(--ink);border-radius:0 12px 12px 12px}\n.chat-row.a .bubble{border-radius:12px 0 12px 12px;background:#fbfbfa}\n.bubble .label{display:block;font-size:11px;letter-spacing:.16em;color:var(--mid);margin-bottom:5px}\n.bubble h3{margin:0 0 6px;font-size:15.5px;letter-spacing:.03em}\n.bubble p{margin:0;font-size:14.5px;color:var(--ink-2)}\n.bubble p + p{margin-top:8px}\n\n/* 说明清单 */\n.notes{display:grid;grid-template-columns:repeat(2,1fr);gap:0;border-top:1px solid var(--line)}\n.notes article{padding:18px 18px 18px 0;border-bottom:1px solid var(--line)}\n.notes article:nth-child(2n){padding-left:18px;border-left:1px solid var(--line)}\n.notes h3{margin:0 0 6px;font-size:15px;letter-spacing:.04em}\n.notes p{margin:0;font-size:14px;color:var(--ink-2)}\n\nfooter{background:var(--card);border-top:1px solid var(--line);padding:34px 0 44px;font-size:13px;color:var(--mid)}\nfooter .frow{display:flex;flex-wrap:wrap;gap:10px 22px;justify-content:space-between;align-items:baseline}\nfooter strong{color:var(--ink);letter-spacing:.1em;font-size:14px}\nfooter a{border-bottom-style:dotted}\n\n@media (max-width:760px){\n  .plans,.steps,.notes{grid-template-columns:1fr}\n  .notes article:nth-child(2n){padding-left:0;border-left:0}\n  .strip{grid-template-columns:1fr}\n  .strip div{border-right:0;border-bottom:1px solid var(--line)}\n  .strip div:last-child{border-bottom:0}\n  .hero{padding:40px 0 34px}\n  section{padding:40px 0}\n}\n</style><header class=\"hero\">\n  <div class=\"wrap\">\n    <div class=\"hero-top\">\n      <h1>落英<span class=\"dot\">.</span></h1>\n      <p class=\"jump\"><b>跳到</b><a href=\"#plans\">套餐对照</a><a href=\"#how\">使用步骤</a><a href=\"#notes\">订阅说明</a><a href=\"#faq\">常见问题</a></p>\n    </div>\n    <p class=\"hero-sub\">这个页面只做一件事：把落英的套餐规格、开通顺序和售后边界，按你可以逐条核对的顺序摆出来。没有配图，没有动效，从上往下读就是完整流程。</p>\n\n    <ol class=\"timeline\">\n      <li>\n        <span class=\"node\">1</span>\n        <h3>先确认需求</h3>\n        <p>数一下同时在线的设备，估一个月的用量大概落在哪一档。设备数是硬条件，流量是软条件，先卡设备数更省事。</p>\n      </li>\n      <li>\n        <span class=\"node\">2</span>\n        <h3>选一档套餐</h3>\n        <p>基础版、旗舰版、团队版三档，差异集中在月流量、同时在线设备数和节点池范围，对照表见下一节。</p>\n      </li>\n      <li>\n        <span class=\"node\">3</span>\n        <h3>获取客户端与账号</h3>\n        <p>开通后按页面说明选择对应系统的客户端，用账号信息登录。具体下载地址以开通时页面给出的信息为准。</p>\n      </li>\n      <li>\n        <span class=\"node\">4</span>\n        <h3>核对流量与设备</h3>\n        <p>首次登录后先看一遍剩余流量与已登录设备数，确认与自己选的档位一致，再开始日常使用。</p>\n      </li>\n    </ol>\n  </div>\n</header>\n\n<main>\n\n<section id=\"plans\">\n  <div class=\"wrap\">\n    <div class=\"sec-head\">\n      <span class=\"idx\">01</span>\n      <h2>套餐对照</h2>\n      <p class=\"note\">两栏并列，右侧为推荐档位。价格按月展示，年付另有对应价格。</p>\n    </div>\n\n    <div class=\"plans\">\n      <article class=\"plan\">\n        <h3>基础版</h3>\n        <p class=\"who\">适合单人或一台主力设备为主的日常使用</p>\n        <p class=\"price\"><strong>¥15</strong><span>/ 月</span></p>\n        <p class=\"annual\">按年付 ¥150 / 年，折合每月更省</p>\n        <ul>\n          <li>每月 100GB 流量额度</li>\n          <li>支持 3 台设备同时在线</li>\n          <li>基础流媒体解锁</li>\n          <li>普通线路节点池</li>\n        </ul>\n        <p class=\"foot\">超出当月额度后的处理方式，见下方「订阅说明」。</p>\n      </article>\n\n      <article class=\"plan rec\">\n        <span class=\"rec-badge\">推荐</span>\n        <h3>旗舰版</h3>\n        <p class=\"who\">适合手机、笔电、平板同时在线的个人用户</p>\n        <p class=\"price\"><strong>¥35</strong><span>/ 月</span></p>\n        <p class=\"annual\">按年付 ¥350 / 年，折合每月更省</p>\n        <ul>\n          <li>每月 300GB 流量额度</li>\n          <li>支持 5 台设备同时在线</li>\n          <li>全节点原生流媒体解锁</li>\n          <li>IPLC 专线游戏加速优化</li>\n          <li>7x24 优先工单支持</li>\n        </ul>\n        <p class=\"foot\">对线路类型有明确要求时，优先考虑这一档。</p>\n      </article>\n    </div>\n\n    <div class=\"plans\">\n      <article class=\"plan\">\n        <h3>团队版</h3>\n        <p class=\"who\">适合小组共用，需要统一分配设备的场景</p>\n        <p class=\"price\"><strong>¥85</strong><span>/ 月</span></p>\n        <p class=\"annual\">按年付 ¥850 / 年，折合每月更省</p>\n        <ul>\n          <li>每月 1000GB 流量额度</li>\n          <li>支持 20 台设备同时在线</li>\n          <li>VIP 专属高带宽节点</li>\n          <li>支持企业定制路由</li>\n          <li>专属客户经理服务</li>\n        </ul>\n        <p class=\"foot\">定制路由的具体配置范围，需开通前与客户经理确认。</p>\n      </article>\n\n      <article class=\"plan\">\n        <h3>三档差异速览</h3>\n        <p class=\"who\">只对比变化的部分，其余权益三档一致</p>\n        <ul>\n          <li>月流量：100GB / 300GB / 1000GB</li>\n          <li>同时在线设备：3 / 5 / 20 台</li>\n          <li>节点池：普通线路 / 全节点 / VIP 专线</li>\n          <li>支持方式：常规工单 / 优先工单 / 专属客户经理</li>\n        </ul>\n        <p class=\"foot\">年付价格分别为 ¥150、¥350、¥850。</p>\n      </article>\n    </div>\n\n    <div class=\"strip\">\n      <div><span class=\"k\">计费周期</span><span class=\"v\">按月 / 按年</span></div>\n      <div><span class=\"k\">设备上限</span><span class=\"v\">3 / 5 / 20 台</span></div>\n      <div><span class=\"k\">年付价格</span><span class=\"v\">¥150 / ¥350 / ¥850</span></div>\n    </div>\n  </div>\n</section>\n\n<section id=\"how\">\n  <div class=\"wrap\">\n    <div class=\"sec-head\">\n      <span class=\"idx\">02</span>\n      <h2>使用步骤</h2>\n      <p class=\"note\">四步走完即可开始使用；每一步都给出了该确认的东西。</p>\n    </div>\n\n    <div class=\"steps\">\n      <article class=\"step-ticket\">\n        <span class=\"num\">01</span>\n        <h3>确定档位</h3>\n        <p>先数设备，再看月用量。设备数超过档位上限时，换档比事后挤设备更省事。</p>\n      </article>\n      <article class=\"step-ticket\">\n        <span class=\"num\">02</span>\n        <h3>完成开通</h3>\n        <p>按所选周期（月付或年付）完成开通，页面会给出对应的账号信息与有效期。</p>\n      </article>\n      <article class=\"step-ticket\">\n        <span class=\"num\">03</span>\n        <h3>安装客户端</h3>\n        <p>按自己的操作系统选择对应客户端，用开通时拿到的账号信息登录，无需额外配置。</p>\n      </article>\n      <article class=\"step-ticket\">\n        <span class=\"num\">04</span>\n        <h3>核对状态</h3>\n        <p>登录后先确认剩余流量、有效期与同时在线设备数，三项与所选档位一致即可正常使用。</p>\n      </article>\n    </div>\n\n    <p class=\"hint\"><strong>一句提醒：</strong>客户端的下载地址与账号信息以开通后页面给出的内容为准，本页不提供下载入口，也不代存账号。</p>\n  </div>\n</section>\n\n<section id=\"notes\">\n  <div class=\"wrap\">\n    <div class=\"sec-head\">\n      <span class=\"idx\">03</span>\n      <h2>订阅说明</h2>\n      <p class=\"note\">把容易产生误会的地方提前写清楚，省得后面对不上。</p>\n    </div>\n\n    <div class=\"notes\">\n      <article>\n        <h3>流量按月重置</h3>\n        <p>每档套餐的流量额度按一个月度周期计算，周期结束后重新开始计数，未用完的部分不累计到下个周期。</p>\n      </article>\n      <article>\n        <h3>设备数按在线计</h3>\n        <p>设备上限针对「同时在线」的设备数量。换设备使用前，先在旧设备上退出登录，避免占用名额。</p>\n      </article>\n      <article>\n        <h3>年付与月付的差别</h3>\n        <p>两种周期提供的权益完全相同，差别只在价格与结算方式。年付一次结清，月付按月结算。</p>\n      </article>\n      <article>\n        <h3>线路以实际为准</h3>\n        <p>套餐中列出的线路类型为档位描述，具体可用节点以客户端内实际显示为准，不承诺固定节点名单。</p>\n      </article>\n      <article>\n        <h3>支持渠道</h3>\n        <p>基础版使用常规工单，旗舰版为优先工单，团队版由专属客户经理对接。工单响应时间以实际受理情况为准。</p>\n      </article>\n      <article>\n        <h3>本页的边界</h3>\n        <p>本页只描述套餐规格与使用顺序，不包含付款、下载或账号操作。任何与页面描述不一致的地方，以开通时给出的信息为准。</p>\n      </article>\n    </div>\n  </div>\n</section>\n\n<section id=\"faq\">\n  <div class=\"wrap\">\n    <div class=\"sec-head\">\n      <span class=\"idx\">04</span>\n      <h2>常见问题</h2>\n      <p class=\"note\">按被问到的顺序排列，问题在上，回答在下。</p>\n    </div>\n\n    <div class=\"chat\">\n      <div class=\"chat-row q\">\n        <span class=\"avatar\">问</span>\n        <div class=\"bubble\">\n          <span class=\"label\">问题</span>\n          <h3>三档套餐最关键的差别是什么？</h3>\n        </div>\n      </div>\n      <div class=\"chat-row a\">\n        <span class=\"avatar\">答</span>\n        <div class=\"bubble\">\n          <span class=\"label\">回答</span>\n          <p>月流量、同时在线设备数、节点池范围这三项。基础版 100GB / 3 台，旗舰版 300GB / 5 台，团队版 1000GB / 20 台。其余权益基本一致，只是支持渠道随档位提升。</p>\n        </div>\n      </div>\n\n      <div class=\"chat-row q\">\n        <span class=\"avatar\">问</span>\n        <div class=\"bubble\">\n          <span class=\"label\">问题</span>\n          <h3>应该选月付还是年付？</h3>\n        </div>\n      </div>\n      <div class=\"chat-row a\">\n        <span class=\"avatar\">答</span>\n        <div class=\"bubble\">\n          <span class=\"label\">回答</span>\n          <p>权益一样，差别在结算方式。还没确定会长期用，就先月付试一个周期；确定要持续用，再换年付。三档的年付价格分别是 ¥150、¥350、¥850。</p>\n        </div>\n      </div>\n\n      <div class=\"chat-row q\">\n        <span class=\"avatar\">问</span>\n        <div class=\"bubble\">\n          <span class=\"label\">问题</span>\n          <h3>设备数量超了会怎样？</h3>\n        </div>\n      </div>\n      <div class=\"chat-row a\">\n        <span class=\"avatar\">答</span>\n        <div class=\"bubble\">\n          <span class=\"label\">回答</span>\n          <p>设备上限按同时在线计算。先在不用的设备上退出登录腾出名额；如果长期设备就这么多，直接换上一档更稳，不用反复挤。</p>\n        </div>\n      </div>\n\n      <div class=\"chat-row q\">\n        <span class=\"avatar\">问</span>\n        <div class=\"bubble\">\n          <span class=\"label\">问题</span>\n          <h3>当月流量用完了怎么办？</h3>\n        </div>\n      </div>\n      <div class=\"chat-row a\">\n        <span class=\"avatar\">答</span>\n        <div class=\"bubble\">\n          <span class=\"label\">回答</span>\n          <p>流量按月度周期重置，未用完的部分不累计。用量经常贴着上限，说明档位估低了，下一周期换更高一档比每月掐着用更省心。</p>\n        </div>\n      </div>\n\n      <div class=\"chat-row q\">\n        <span class=\"avatar\">问</span>\n        <div class=\"bubble\">\n          <span class=\"label\">问题</span>\n          <h3>客户端在哪里下载？</h3>\n        </div>\n      </div>\n      <div class=\"chat-row a\">\n        <span class=\"avatar\">答</span>\n        <div class=\"bubble\">\n          <span class=\"label\">回答</span>\n          <p>本页不放下载入口。开通完成后，按页面给出的系统对应说明获取客户端并登录，具体地址以那时显示的信息为准。</p>\n        </div>\n      </div>\n\n      <div class=\"chat-row q\">\n        <span class=\"avatar\">问</span>\n        <div class=\"bubble\">\n          <span class=\"label\">问题</span>\n          <h3>团队版的企业定制路由需要提前说吗？</h3>\n        </div>\n      </div>\n      <div class=\"chat-row a\">\n        <span class=\"avatar\">答</span>\n        <div class=\"bubble\">\n          <span class=\"label\">回答</span>\n          <p>需要。定制路由涉及具体分流规则和适用设备范围，开通前找专属客户经理确认，能避免开通后再改配置。</p>\n        </div>\n      </div>\n    </div>\n  </div>\n</section>\n\n</main>\n\n<footer>\n  <div class=\"wrap frow\">\n    <strong>落英</strong>\n    <span>套餐规格与使用说明以本页正文为准；不提供下载与付款入口。</span>\n    <span><a href=\"#plans\">回到套餐对照</a> · <a href=\"#faq\">回到常见问题</a></span>\n  </div>\n</footer>",
